# ── Environment Variables ─────────────────────────────────────
# Copy this file to `.env` and adjust values as needed.
#
# All variables are optional — sensible defaults are defined in
# app/core/config.py

APP_NAME=VendorBridge ERP
APP_VERSION=0.1.0
DEBUG=false

# SQLite (default). Switch to PostgreSQL for production:
# DATABASE_URL=postgresql://user:pass@localhost:5432/vendorbridge
DATABASE_URL=sqlite:///./vendorbridge.db
